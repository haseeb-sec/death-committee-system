# Death Committee System environment
# Copy this file to .env and replace the placeholder secrets.
SECRET_KEY=replace-with-a-long-random-secret-at-least-32-characters
POSTGRES_PASSWORD=replace-with-a-strong-postgresql-password
DATABASE_URL=postgresql+psycopg://death_committee:replace-with-postgresql-password@postgres:5432/death_committee
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
