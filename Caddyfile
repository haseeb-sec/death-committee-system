{
    local_certs
}

https://localhost {
    tls internal

    header {
        X-Content-Type-Options nosniff
        X-Frame-Options DENY
        Referrer-Policy strict-origin-when-cross-origin
    }

    handle /auth/* {
        reverse_proxy backend:8000
    }

    handle /users {
        reverse_proxy backend:8000
    }

    handle /users/* {
        reverse_proxy backend:8000
    }

    handle /committees {
        reverse_proxy backend:8000
    }

    handle /committees/* {
        reverse_proxy backend:8000
    }

    handle /members {
        reverse_proxy backend:8000
    }

    handle /members/* {
        reverse_proxy backend:8000
    }


    handle /audit-logs {
        reverse_proxy backend:8000
    }

    handle /audit-logs/* {
        reverse_proxy backend:8000
    }

    handle /assets/* {
        reverse_proxy frontend:80
    }

    handle {
        reverse_proxy frontend:80
    }
}
