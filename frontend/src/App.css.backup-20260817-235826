/* =========================================================
   LOGIN
   ========================================================= */

.login-page {
  min-height: 100vh;
  display: grid;
  place-items: center;
  padding: 32px 20px;
  position: relative;
  overflow: hidden;
}

.login-page::before,
.login-page::after {
  content: "";
  position: absolute;
  border-radius: 999px;
  filter: blur(2px);
  pointer-events: none;
  animation: float 8s ease-in-out infinite;
}

.login-page::before {
  width: 420px;
  height: 420px;
  top: -180px;
  right: -120px;
  background: rgba(37, 99, 235, 0.08);
}

.login-page::after {
  width: 340px;
  height: 340px;
  bottom: -160px;
  left: -120px;
  background: rgba(14, 165, 233, 0.06);
  animation-delay: -3s;
}

.login-card {
  width: min(100%, 440px);
  padding: 42px;
  background: rgba(255, 255, 255, 0.94);
  border: 1px solid rgba(229, 231, 235, 0.9);
  border-radius: 22px;
  box-shadow: var(--shadow-lg);
  position: relative;
  z-index: 1;
  animation: loginEnter 500ms cubic-bezier(0.22, 1, 0.36, 1);
  backdrop-filter: blur(12px);
}

.brand-mark {
  width: 52px;
  height: 52px;
  display: grid;
  place-items: center;
  border-radius: 14px;
  color: white;
  background: linear-gradient(135deg, #2563eb, #1d4ed8);
  font-size: 18px;
  font-weight: 800;
  letter-spacing: -0.5px;
  box-shadow:
    0 8px 20px rgba(37, 99, 235, 0.22),
    inset 0 1px 0 rgba(255, 255, 255, 0.25);
}

.brand-mark.small {
  width: 40px;
  height: 40px;
  border-radius: 11px;
  font-size: 14px;
  flex-shrink: 0;
}

.eyebrow {
  margin: 0;
  color: var(--primary);
  font-size: 11px;
  line-height: 1.4;
  font-weight: 800;
  letter-spacing: 0.12em;
}

.login-card .eyebrow {
  margin-top: 26px;
}

.login-card h1 {
  margin: 9px 0 12px;
  color: var(--text);
  font-size: clamp(28px, 5vw, 34px);
  line-height: 1.12;
  letter-spacing: -0.8px;
}

.login-description {
  margin: 0;
  color: var(--text-muted);
  font-size: 14px;
  line-height: 1.65;
}

.login-form {
  margin-top: 30px;
  display: grid;
  gap: 19px;
}

.login-form label,
.committee-loader label {
  display: grid;
  gap: 8px;
  color: #344054;
  font-size: 13px;
  font-weight: 700;
}

.login-form input,
.committee-loader input {
  width: 100%;
  min-height: 46px;
  border: 1px solid #d0d5dd;
  border-radius: 10px;
  background: #fff;
  color: var(--text);
  padding: 0 13px;
  outline: none;
  transition:
    border-color var(--transition),
    box-shadow var(--transition),
    background var(--transition);
}

.login-form input:hover,
.committee-loader input:hover {
  border-color: #b7c0cd;
}

.login-form input:focus,
.committee-loader input:focus {
  border-color: var(--primary);
  box-shadow: 0 0 0 4px rgba(37, 99, 235, 0.1);
}

.password-field {
  position: relative;
  display: flex;
  align-items: center;
}

.password-field input {
  padding-right: 52px;
}

.password-toggle {
  position: absolute;
  right: 7px;
  top: 50%;
  transform: translateY(-50%);
  width: 36px;
  height: 36px;
  padding: 7px;
  display: grid;
  place-items: center;
  border: 0;
  border-radius: 8px;
  color: #667085;
  background: transparent;
  transition:
    color var(--transition),
    background var(--transition),
    transform var(--transition);
}

.password-toggle:hover {
  color: var(--primary);
  background: var(--primary-soft);
}

.password-toggle:active {
  transform: translateY(-50%) scale(0.94);
}

.password-toggle:focus-visible {
  outline: 2px solid var(--primary);
  outline-offset: 2px;
}

.password-toggle svg {
  width: 19px;
  height: 19px;
  fill: none;
  stroke: currentColor;
  stroke-width: 1.8;
  stroke-linecap: round;
  stroke-linejoin: round;
}

.login-form > button,
.committee-loader button {
  min-height: 46px;
  border: 0;
  border-radius: 10px;
  color: white;
  background: linear-gradient(135deg, var(--primary), var(--primary-dark));
  font-weight: 700;
  box-shadow: 0 7px 16px rgba(37, 99, 235, 0.18);
  transition:
    transform var(--transition),
    box-shadow var(--transition),
    filter var(--transition);
}

.login-form > button:hover,
.committee-loader button:hover {
  transform: translateY(-1px);
  box-shadow: 0 10px 22px rgba(37, 99, 235, 0.24);
  filter: brightness(1.02);
}

.login-form > button:active,
.committee-loader button:active {
  transform: translateY(0);
}

.login-form > button:disabled,
.committee-loader button:disabled {
  opacity: 0.65;
  transform: none;
  box-shadow: none;
}

.error {
  padding: 11px 13px;
  border: 1px solid #fecaca;
  border-radius: 9px;
  background: var(--danger-soft);
  color: #b42318;
  font-size: 13px;
  line-height: 1.45;
  animation: errorEnter 220ms ease-out;
}


/* =========================================================
   APPLICATION SHELL
   ========================================================= */

.app-shell {
  min-height: 100vh;
  display: flex;
  background: #f5f7fb;
}

.sidebar {
  width: 248px;
  min-height: 100vh;
  padding: 22px 14px;
  display: flex;
  flex-direction: column;
  background:
    linear-gradient(
      180deg,
      #111827 0%,
      #111827 72%,
      #0f172a 100%
    );
  color: var(--sidebar-text);
  position: sticky;
  top: 0;
  flex-shrink: 0;
  box-shadow: 8px 0 30px rgba(15, 23, 42, 0.08);
}

.sidebar-brand {
  display: flex;
  align-items: center;
  gap: 11px;
  padding: 2px 8px 26px;
}

.sidebar-brand strong,
.sidebar-brand span {
  display: block;
}

.sidebar-brand strong {
  color: #fff;
  font-size: 14px;
  line-height: 1.35;
  letter-spacing: -0.1px;
}

.sidebar-brand span {
  margin-top: 2px;
  color: #9ca3af;
  font-size: 11px;
}

.sidebar nav {
  display: grid;
  gap: 4px;
}

.nav-item {
  width: 100%;
  min-height: 42px;
  padding: 0 12px;
  border: 1px solid transparent;
  border-radius: 9px;
  background: transparent;
  color: #9ca3af;
  text-align: left;
  font-size: 13px;
  font-weight: 600;
  transition:
    color var(--transition),
    background var(--transition),
    border-color var(--transition),
    transform var(--transition);
}

.nav-item:hover {
  color: #fff;
  background: rgba(255, 255, 255, 0.06);
  transform: translateX(2px);
}

.nav-item.active {
  color: #fff;
  background: rgba(37, 99, 235, 0.2);
  border-color: rgba(96, 165, 250, 0.16);
  box-shadow: inset 3px 0 0 #60a5fa;
}

.logout-button {
  margin-top: auto;
  min-height: 42px;
  border: 1px solid rgba(255, 255, 255, 0.08);
  border-radius: 9px;
  background: rgba(255, 255, 255, 0.04);
  color: #d1d5db;
  font-size: 13px;
  font-weight: 600;
  transition:
    background var(--transition),
    color var(--transition),
    transform var(--transition);
}

.logout-button:hover {
  color: #fff;
  background: rgba(220, 38, 38, 0.14);
  transform: translateY(-1px);
}

.main-content {
  min-width: 0;
  flex: 1;
}

.topbar {
  min-height: 82px;
  padding: 18px 34px;
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: rgba(255, 255, 255, 0.88);
  border-bottom: 1px solid var(--border);
  backdrop-filter: blur(12px);
  position: sticky;
  top: 0;
  z-index: 10;
}

.topbar h2 {
  margin: 4px 0 0;
  color: var(--text);
  font-size: 22px;
  letter-spacing: -0.4px;
}

.status-pill {
  min-height: 34px;
  padding: 0 12px;
  display: inline-flex;
  align-items: center;
  gap: 8px;
  border: 1px solid #d1fae5;
  border-radius: 999px;
  background: var(--success-soft);
  color: #047857;
  font-size: 12px;
  font-weight: 700;
}

.status-pill span {
  width: 7px;
  height: 7px;
  border-radius: 50%;
  background: #10b981;
  box-shadow: 0 0 0 4px rgba(16, 185, 129, 0.1);
  animation: pulse 2s ease-in-out infinite;
}

.content {
  width: min(100%, 1180px);
  margin: 0 auto;
  padding: 34px;
}

.page-heading {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  gap: 30px;
  margin-bottom: 28px;
}

.page-heading h1 {
  margin: 5px 0 8px;
  color: var(--text);
  font-size: clamp(25px, 4vw, 32px);
  line-height: 1.15;
  letter-spacing: -0.8px;
}

.page-heading p {
  color: var(--text-muted);
  font-size: 14px;
}

.committee-loader {
  width: 220px;
  flex-shrink: 0;
}

.committee-loader > div {
  display: grid;
  grid-template-columns: 1fr 82px;
  gap: 8px;
}

.committee-loader input {
  min-height: 42px;
}

.committee-loader button {
  min-height: 42px;
}

.page-error {
  margin-bottom: 20px;
}

.empty-state {
  min-height: 320px;
  padding: 50px 25px;
  display: grid;
  place-items: center;
  align-content: center;
  text-align: center;
  border: 1px dashed #cbd5e1;
  border-radius: var(--radius-lg);
  background: rgba(255, 255, 255, 0.7);
  animation: fadeUp 400ms ease-out;
}

.empty-icon {
  width: 58px;
  height: 58px;
  display: grid;
  place-items: center;
  margin-bottom: 17px;
  border-radius: 16px;
  background: var(--primary-soft);
  color: var(--primary);
  font-size: 25px;
  font-weight: 800;
}

.empty-state h3 {
  margin: 0 0 7px;
  color: var(--text);
  font-size: 18px;
}

.empty-state p {
  max-width: 430px;
  margin: 0;
  color: var(--text-muted);
  font-size: 13px;
  line-height: 1.6;
}


/* =========================================================
   COMMITTEE
   ========================================================= */

.committee-banner {
  min-height: 92px;
  padding: 20px 22px;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20px;
  border: 1px solid var(--border);
  border-radius: var(--radius);
  background: var(--surface);
  box-shadow: var(--shadow-sm);
  animation: fadeUp 420ms ease-out;
}

.committee-banner h3 {
  margin: 5px 0 0;
  color: var(--text);
  font-size: 19px;
  letter-spacing: -0.3px;
}

.active-badge,
.inactive-badge {
  min-height: 30px;
  padding: 0 11px;
  display: inline-flex;
  align-items: center;
  border-radius: 999px;
  font-size: 11px;
  font-weight: 800;
}

.active-badge {
  color: #047857;
  background: var(--success-soft);
  border: 1px solid #a7f3d0;
}

.inactive-badge {
  color: #b42318;
  background: var(--danger-soft);
  border: 1px solid #fecaca;
}

.stats-grid {
  margin-top: 18px;
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 18px;
}

.stat-card {
  min-height: 155px;
  padding: 22px;
  border: 1px solid var(--border);
  border-radius: var(--radius);
  background: var(--surface);
  box-shadow: var(--shadow-sm);
  animation: fadeUp 480ms ease-out both;
  transition:
    transform var(--transition),
    box-shadow var(--transition),
    border-color var(--transition);
}

.stat-card:nth-child(2) {
  animation-delay: 60ms;
}

.stat-card:nth-child(3) {
  animation-delay: 120ms;
}

.stat-card:hover {
  transform: translateY(-3px);
  box-shadow: var(--shadow);
  border-color: #d7dce3;
}

.stat-card > span {
  display: block;
  color: var(--text-muted);
  font-size: 12px;
  font-weight: 700;
}

.stat-card strong {
  display: block;
  margin: 12px 0 7px;
  color: var(--text);
  font-size: clamp(23px, 3vw, 28px);
  letter-spacing: -0.7px;
}

.stat-card small {
  color: var(--text-light);
  font-size: 11px;
}

.stat-card.primary {
  background:
    linear-gradient(
      145deg,
      #2563eb 0%,
      #1d4ed8 100%
    );
  border-color: #2563eb;
  box-shadow: 0 14px 30px rgba(37, 99, 235, 0.2);
}

.stat-card.primary > span,
.stat-card.primary strong,
.stat-card.primary small {
  color: #fff;
}

.stat-card.primary > span,
.stat-card.primary small {
  opacity: 0.78;
}

.information-card {
  margin-top: 18px;
  padding: 24px;
  border: 1px solid var(--border);
  border-radius: var(--radius);
  background: var(--surface);
  box-shadow: var(--shadow-sm);
  animation: fadeUp 520ms ease-out;
}

.information-card h3 {
  margin: 5px 0 20px;
  color: var(--text);
  font-size: 17px;
  letter-spacing: -0.2px;
}

.position-row {
  min-height: 48px;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20px;
  border-top: 1px solid var(--border-light);
  color: var(--text-muted);
  font-size: 13px;
}

.position-row strong {
  color: var(--text);
  font-weight: 700;
  text-align: right;
}


/* =========================================================
   ANIMATIONS
   ========================================================= */

@keyframes loginEnter {
  from {
    opacity: 0;
    transform: translateY(18px) scale(0.985);
  }

  to {
    opacity: 1;
    transform: translateY(0) scale(1);
  }
}

@keyframes fadeUp {
  from {
    opacity: 0;
    transform: translateY(12px);
  }

  to {
    opacity: 1;
    transform: translateY(0);
  }
}

@keyframes errorEnter {
  from {
    opacity: 0;
    transform: translateY(-5px);
  }

  to {
    opacity: 1;
    transform: translateY(0);
  }
}

@keyframes float {
  0%,
  100% {
    transform: translate3d(0, 0, 0);
  }

  50% {
    transform: translate3d(0, 14px, 0);
  }
}

@keyframes pulse {
  0%,
  100% {
    opacity: 1;
    transform: scale(1);
  }

  50% {
    opacity: 0.65;
    transform: scale(0.82);
  }
}


/* =========================================================
   RESPONSIVE
   ========================================================= */

@media (max-width: 900px) {
  .sidebar {
    width: 210px;
  }

  .content {
    padding: 28px 22px;
  }

  .topbar {
    padding-inline: 22px;
  }

  .page-heading {
    align-items: stretch;
    flex-direction: column;
    gap: 20px;
  }

  .committee-loader {
    width: min(100%, 280px);
  }

  .stats-grid {
    grid-template-columns: 1fr;
  }
}

@media (max-width: 700px) {
  .app-shell {
    display: block;
  }

  .sidebar {
    width: 100%;
    min-height: auto;
    padding: 13px;
    position: relative;
  }

  .sidebar-brand {
    padding: 3px 6px 13px;
  }

  .sidebar nav {
    display: flex;
    overflow-x: auto;
    padding-bottom: 2px;
    scrollbar-width: none;
  }

  .sidebar nav::-webkit-scrollbar {
    display: none;
  }

  .nav-item {
    width: auto;
    min-width: max-content;
    padding-inline: 13px;
  }

  .nav-item.active {
    box-shadow: inset 0 -3px 0 #60a5fa;
  }

  .logout-button {
    margin-top: 10px;
  }

  .topbar {
    min-height: 72px;
    padding: 15px 18px;
  }

  .content {
    padding: 22px 16px 30px;
  }

  .status-pill {
    display: none;
  }

  .committee-banner {
    align-items: flex-start;
    flex-direction: column;
  }

  .position-row {
    align-items: flex-start;
    flex-direction: column;
    justify-content: center;
    gap: 5px;
    padding: 10px 0;
  }

  .position-row strong {
    text-align: left;
  }
}

@media (max-width: 480px) {
  .login-page {
    padding: 18px 14px;
  }

  .login-card {
    padding: 30px 22px;
    border-radius: 18px;
  }

  .login-card h1 {
    font-size: 27px;
  }

  .page-heading h1 {
    font-size: 25px;
  }

  .committee-loader {
    width: 100%;
  }

  .information-card {
    padding: 19px;
  }

  .stat-card {
    min-height: 140px;
    padding: 19px;
  }
}

@media (prefers-reduced-motion: reduce) {
  *,
  *::before,
  *::after {
    animation-duration: 0.01ms !important;
    animation-iteration-count: 1 !important;
    transition-duration: 0.01ms !important;
    scroll-behavior: auto !important;
  }
}

/* =========================================================
   MODULE PLACEHOLDER
   ========================================================= */

.module-placeholder {
  min-height: 430px;
  padding: 60px 30px;
  display: grid;
  place-items: center;
  align-content: center;
  text-align: center;
  border: 1px solid var(--border);
  border-radius: var(--radius-lg);
  background: var(--surface);
  box-shadow: var(--shadow-sm);
  animation: fadeUp 400ms ease-out;
}

.module-placeholder-icon {
  width: 68px;
  height: 68px;
  display: grid;
  place-items: center;
  margin-bottom: 22px;
  border-radius: 18px;
  color: white;
  background: linear-gradient(135deg, var(--primary), var(--primary-dark));
  font-size: 18px;
  font-weight: 800;
  box-shadow: 0 12px 26px rgba(37, 99, 235, 0.18);
}

.module-placeholder h1 {
  margin: 6px 0 10px;
  color: var(--text);
  font-size: clamp(27px, 4vw, 34px);
  letter-spacing: -0.7px;
}

.module-placeholder > p:not(.eyebrow) {
  max-width: 540px;
  margin: 0;
  color: var(--text-muted);
  font-size: 14px;
  line-height: 1.7;
}

.module-placeholder-status {
  min-height: 36px;
  margin-top: 24px;
  padding: 0 13px;
  display: inline-flex;
  align-items: center;
  gap: 8px;
  border: 1px solid #d1fae5;
  border-radius: 999px;
  background: var(--success-soft);
  color: #047857;
  font-size: 12px;
  font-weight: 700;
}

.module-placeholder-status span {
  width: 7px;
  height: 7px;
  border-radius: 50%;
  background: #10b981;
}

@media (max-width: 480px) {
  .module-placeholder {
    min-height: 360px;
    padding: 40px 20px;
  }
}


/* =========================================================
   COMMITTEE CREATION FORM
   ========================================================= */

.committee-create-form {
  margin-top: 22px;
  display: grid;
  grid-template-columns: minmax(0, 1fr) auto;
  align-items: end;
  gap: 12px;
}

.committee-create-form label {
  display: grid;
  gap: 8px;
  min-width: 0;
  color: #344054;
  font-size: 13px;
  font-weight: 700;
}

.committee-create-form input {
  width: 100%;
  min-width: 0;
  min-height: 46px;
  box-sizing: border-box;
  border: 1px solid #d0d5dd;
  border-radius: 10px;
  background: #fff;
  color: var(--text);
  padding: 0 13px;
  outline: none;
  font: inherit;
  font-weight: 400;
  transition:
    border-color var(--transition),
    box-shadow var(--transition),
    background var(--transition);
}

.committee-create-form input:hover {
  border-color: #b7c0cd;
}

.committee-create-form input:focus {
  border-color: var(--primary);
  box-shadow: 0 0 0 4px rgba(37, 99, 235, 0.1);
}

.committee-create-form button {
  min-height: 46px;
  padding: 0 20px;
  border: 0;
  border-radius: 10px;
  color: #fff;
  background: linear-gradient(135deg, var(--primary), var(--primary-dark));
  font-weight: 700;
  white-space: nowrap;
  box-shadow: 0 7px 16px rgba(37, 99, 235, 0.18);
  transition:
    transform var(--transition),
    box-shadow var(--transition),
    filter var(--transition);
}

.committee-create-form button:hover {
  transform: translateY(-1px);
  box-shadow: 0 10px 22px rgba(37, 99, 235, 0.24);
  filter: brightness(1.02);
}

.committee-create-form button:active {
  transform: translateY(0);
}

.committee-create-form button:disabled {
  opacity: 0.65;
  transform: none;
  box-shadow: none;
}

.form-help {
  margin: 6px 0 0;
  color: var(--text-muted);
  font-size: 13px;
  line-height: 1.5;
}

.created-id {
  margin: 5px 0 0;
  color: var(--text-muted);
  font-size: 12px;
}

@media (max-width: 700px) {
  .committee-create-form {
    grid-template-columns: 1fr;
    align-items: stretch;
  }

  .committee-create-form button {
    width: 100%;
  }
}
